# Copy this file to ".env" and fill in your real credentials.
# Never commit the ".env" file (add it to .gitignore).
# You can find these values in DBeaver: right-click your BDD3 connection > Edit Connection

DB_HOST=your_host_here
DB_PORT=5432
DB_NAME=your_database_name_here
DB_USER=your_username_here
DB_PASSWORD=your_password_here

# Set to "true" to use local sample CSV files instead of a real DB connection.
# Defaults to "false" if this line is missing entirely - a deployment
# without any .env (maintainer's PC, credentials come from the encrypted
# files instead) never ends up in sample-data mode by accident.
USE_SAMPLE_DATA=false
